# =============================================================================
# Dolibarr - Configuration des variables d'environnement
# =============================================================================
# Copiez ce fichier et adaptez les valeurs avant de lancer :
#   docker compose up
#
# IMPORTANT : Ne commitez JAMAIS ce fichier avec des mots de passe réels.
#             Ajoutez ".env" à votre .gitignore.
# =============================================================================


# -----------------------------------------------------------------------------
# SOCIÉTÉ
# -----------------------------------------------------------------------------

# Nom de la société affiché dans Dolibarr
DOLI_COMPANY_NAME=Ma Société

# Code pays de la société (2 lettres ISO 3166-1 alpha-2)
# Exemples : FR, BE, CH, GB, US, DE, ES, IT
# Ce paramètre active aussi les modules comptables propres au pays
DOLI_COMPANY_COUNTRYCODE=FR


# -----------------------------------------------------------------------------
# LANGUE DE L'APPLICATION
# -----------------------------------------------------------------------------

# Fuseau horaire PHP (utilisé pour les dates dans l'application)
# Exemples : Europe/Paris, Europe/Brussels, UTC, America/New_York
PHP_INI_DATE_TIMEZONE=Europe/Paris

# Note : L'image officielle initialise la langue à "auto" (langue du navigateur).
# Pour définir une langue par défaut permanente, connectez-vous en admin puis
# allez dans Admin > Affichage > Langue par défaut (paramètre MAIN_LANG_DEFAULT).
# Codes de langue disponibles : fr_FR, en_US, de_DE, es_ES, it_IT, pt_PT...


# -----------------------------------------------------------------------------
# DONNÉES DE DÉMONSTRATION
# -----------------------------------------------------------------------------

# Charger les données de démonstration lors du premier démarrage
#   0 = Installation vierge (recommandé pour la production)
#   1 = Chargement automatique des données de démo Dolibarr
DOLI_INIT_DEMO=0


# -----------------------------------------------------------------------------
# COMPTE ADMINISTRATEUR DOLIBARR
# -----------------------------------------------------------------------------

# Identifiant de l'administrateur (créé au premier démarrage)
DOLI_ADMIN_LOGIN=admin

# Mot de passe de l'administrateur
# CHANGEZ CETTE VALEUR avant tout déploiement
DOLI_ADMIN_PASSWORD=admin


# -----------------------------------------------------------------------------
# MODULES À ACTIVER À L'INSTALLATION
# -----------------------------------------------------------------------------

# Liste de modules à activer séparés par des virgules (optionnel)
# Nécessite que DOLI_COMPANY_NAME et DOLI_COMPANY_COUNTRYCODE soient définis
# Exemples de noms : Societe, Facture, Commande, Product, Stock, Projet
# Laissez vide pour n'activer que le module User (activé par défaut)
DOLI_ENABLE_MODULES=


# -----------------------------------------------------------------------------
# BASE DE DONNÉES (MariaDB)
# -----------------------------------------------------------------------------

# Mot de passe root MariaDB
# CHANGEZ CETTE VALEUR avant tout déploiement
MYSQL_ROOT_PASSWORD=rootSecretPassword

# Nom de la base de données Dolibarr
DOLI_DB_NAME=dolidb

# Utilisateur de la base de données Dolibarr
DOLI_DB_USER=dolidbuser

# Mot de passe de l'utilisateur de la base de données
# CHANGEZ CETTE VALEUR avant tout déploiement
DOLI_DB_PASSWORD=dolidbSecretPassword


# -----------------------------------------------------------------------------
# RÉSEAU ET ACCÈS WEB
# -----------------------------------------------------------------------------

# Port exposé sur la machine hôte
# Changez si le port 80 est déjà utilisé (ex: 8080)
APP_PORT=80

# URL racine de l'application (doit correspondre au port APP_PORT)
DOLI_URL_ROOT=http://localhost


# -----------------------------------------------------------------------------
# PERFORMANCES PHP
# -----------------------------------------------------------------------------

PHP_INI_MEMORY_LIMIT=256M
PHP_INI_UPLOAD_MAX_FILESIZE=20M
PHP_INI_POST_MAX_SIZE=22M
